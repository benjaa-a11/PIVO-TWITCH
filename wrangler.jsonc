{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pivo-twitch",
  "main": "src/index.js",
  "compatibility_date": "2026-11-27",
  "upload_source_maps": true,
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/live/*"]
  },
  "observability": {
    "enabled": true
  }
}
